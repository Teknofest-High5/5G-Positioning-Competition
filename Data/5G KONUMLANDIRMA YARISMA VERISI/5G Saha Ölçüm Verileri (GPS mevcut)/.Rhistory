setwd("/Users/2na/Documents/5G-Positioning-Competition/Data/5G KONUMLANDIRMA YARISMA VERISI/5G Saha Ölçüm Verileri (GPS mevcut)")
library(factoextra)
library(cluster)
df <- read.csv("5G_DL_DL_Filled.csv")
df <- df[c("Longitude", "Latitude")]
par(mfrow=c(1,2))
boxplot(df)
summary(df)
apply(df,2, var)
set.seed(123)
?fviz_nbclust
library(plotly)
wss_plot <- fviz_nbclust(df, kmeans, method = "wss")
# Silhouette (Ortalama Silhouette genişliği) grafiği
silhouette_plot <- fviz_nbclust(df, kmeans, method = "silhouette") +
labs(subtitle = "Silhouette Method")
# Etkileşimli WSS grafiğini oluştur
interactive_wss <- ggplotly(wss_plot)
# Etkileşimli Silhouette grafiğini oluştur
interactive_silhouette <- ggplotly(silhouette_plot)
interactive_wss
df <- read.csv("5G_DL_DL_Filled.csv")
df <- df[c("Longitude", "Latitude")]
par(mfrow=c(1,2))
boxplot(df)
summary(df)
apply(df,2, var)
set.seed(123)
?fviz_nbclust
library(plotly)
wss_plot <- fviz_nbclust(df, kmeans, method = "wss")
# Silhouette (Ortalama Silhouette genişliği) grafiği
silhouette_plot <- fviz_nbclust(df, kmeans, method = "silhouette") +
labs(subtitle = "Silhouette Method")
# Etkileşimli WSS grafiğini oluştur
interactive_wss <- ggplotly(wss_plot)
